{
  "name": "slack-archive",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@slack/web-api": "^7.9.0",
    "@tailwindcss/vite": "^4.3.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.8.0",
    "i18next": "^26.3.1",
    "lucide-react": "^1.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.17.0",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261025.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "better-sqlite3": "^12.10.1",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1"
    }
  }
}
